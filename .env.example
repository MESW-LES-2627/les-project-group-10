NODE_ENV=development
PORT=3000
# must use the same user, password and database name as the POSTGRES_* values below
DATABASE_URL=postgres://user_name:password@localhost:5432/db_name
# at least 32 characters; see the README for a command that generates one
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
CLIENT_ORIGIN=http://localhost:5173

# stripe sandbox keys (test keys from the Stripe Dashboard)
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_test_publishable_key

# PostgreSQL container
POSTGRES_USER=user_name
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name

# pgAdmin (the email must be a valid address)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=password

# Server deployment only. Keep separate files at /srv/les/staging/.env and
# /srv/les/production/.env; never copy real values into this example.
# Deployment Compose sets NODE_ENV=production and PORT=3000 in both environments.
# Use separate POSTGRES_* credentials and JWT_SECRET values for each environment.
# DATABASE_URL must match POSTGRES_* and use db:5432 instead of localhost:5432.
# CLIENT_ORIGIN=https://les-staging.your-domain.example (staging)
# CLIENT_ORIGIN=https://les.your-domain.example (production)
# CLOUDFLARE_TUNNEL_TOKEN=replace_with_this_environment_tunnel_token
# DEPLOY_ENVIRONMENT and IMAGE_TAG are set by scripts/deploy.sh, not stored here.
