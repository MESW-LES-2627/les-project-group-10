NODE_ENV=development
PORT=3000
# must use the same user, password and database name as the POSTGRES_* values below
DATABASE_URL=postgres://user_name:password@localhost:5432/db_name
# at least 32 characters; see the README for a command that generates one
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
CLIENT_ORIGIN=http://localhost:5173

# Shared Stripe sandbox keys are intentional. Keep them in this example.
STRIPE_SECRET_KEY=sk_test_51USC1DJx5Ed8zuYjwB83flpt9Rg2MXitb3T28r6trLKlequlyFgJFNbzOTWA8Lm7pDGNxJ20kMTLyXTLYYDPMwyq00q9qJlyLE
STRIPE_PUBLISHABLE_KEY=pk_test_51USC1DJx5Ed8zuYj9XiJsbnOIMLSHrJYSkt9hHaLio3Gs9NP8E3ndDEC7dMU6YmAKgmn5LFsovr2dodp19yHKqbm00hGPWcTbf

# PostgreSQL container
POSTGRES_USER=user_name
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name

# pgAdmin (the email must be a valid address)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=password

# Hosted settings live in the separate Vercel staging and production projects.
